# --- Make (webhooks / Google Sheets) ---
MAKE_WEBHOOK_URL=
MAKE_API_KEY=
# Optionnel : secret pour valider des webhooks entrants provenant réellement de Make
MAKE_SIGNATURE_SECRET=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Token de vérification choisi lors de la configuration du webhook (étape GET)
VERIFY_TOKEN=
# App Secret Meta, utilisé pour valider la signature X-Hub-Signature-256 des messages entrants
WHATSAPP_APP_SECRET=

# --- Sécurité des routes internes (/pickup, /commande, /promotions, /fidelite, /human, /send-whatsapp) ---
# Valeur secrète à envoyer dans l'en-tête x-api-key pour appeler ces routes
APP_API_KEY=

# --- Divers ---
PORT=5000
ENABLE_REMINDERS=false
DEBUG_MAKE=false
